#!/usr/bin/env bash
# Block commits that contain secrets. Installed by `make setup`, which points
# core.hooksPath here.
#
# This repo is public, so a leaked credential is public the instant it is
# pushed. The hook is the last cheap place to stop that — after this point the
# only remedy is rotation (see docs/security.md).
set -euo pipefail

if ! command -v gitleaks >/dev/null 2>&1; then
  # Fail closed. A silently-skipped secret scan is worse than a blocked commit:
  # it looks exactly like a passing one.
  printf '\033[31mgitleaks not installed — cannot scan for secrets.\033[0m\n' >&2
  printf 'install:  brew install gitleaks\n' >&2
  printf 'then:     make setup\n' >&2
  exit 1
fi

# --staged scans the index, which is what is actually about to be committed —
# not the worktree, which may contain unstaged edits that mask a staged secret.
if ! gitleaks git --staged --redact --no-banner .; then
  printf '\n\033[31mCommit blocked: a possible secret is staged.\033[0m\n' >&2
  printf 'If it is real, ROTATE IT FIRST — do not just unstage it.\n' >&2
  printf 'See docs/security.md.\n' >&2
  printf 'If it is a false positive, annotate the line with: gitleaks:allow\n' >&2
  exit 1
fi
