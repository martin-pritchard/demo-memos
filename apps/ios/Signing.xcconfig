// Signing.xcconfig — committed. Holds no personal identity.
//
// Deploying to a physical device needs an Apple Developer Team, but a Team ID is
// personal and must not live in this public repo. So it lives in Local.xcconfig
// (gitignored, per-developer) and is pulled in below ONLY IF that file exists.
//
// The `?` makes the include optional: on a developer's machine with a Local.xcconfig
// their team applies to device builds; on CI and fresh clones the file is absent, the
// include is skipped silently (no warning), and the build targets the Simulator — which
// needs no code signing at all.
//
// Setup for on-device builds: create apps/ios/Local.xcconfig containing
//   DEVELOPMENT_TEAM = YOURTEAMID
// It is gitignored, so it never gets committed.

#include? "Local.xcconfig"
